# Firewall Integration Test Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
# MySQL/MariaDB
DB_MYSQL_HOST=mysql
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=firewall_test
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=password
DB_MYSQL_DSN="mysqli://root:password@mysql:3306/firewall_test?serverVersion=10.6"

# PostgreSQL
DB_PGSQL_HOST=postgres
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=firewall_test
DB_PGSQL_USERNAME=postgres
DB_PGSQL_PASSWORD=password
DB_PGSQL_DSN="pgsql://postgres:password@postgres:5432/firewall_test?serverVersion=17.5"

# SQLite (for testing)
DB_SQLITE_PATH=/tmp/firewall_test.db

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DATABASE=0

# MaxMind GeoIP Database Paths
# Download from: https://dev.maxmind.com/geoip/geoip2/geolite2/
MAXMIND_CITY_DB=/tmp/geoip/GeoLite2-City.mmdb
MAXMIND_COUNTRY_DB=/tmp/geoip/GeoLite2-Country.mmdb
MAXMIND_ASN_DB=/tmp/geoip/GeoLite2-ASN.mmdb

# MaxMind Web Service (optional, if not using local databases)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_HOST=geoip.maxmind.com

# Test Configuration
# Directory for temporary test files
TEST_TEMP_DIR=/tmp/firewall_tests

# Enable/disable specific test groups
TEST_SKIP_DATABASE=false
TEST_SKIP_REDIS=false
TEST_SKIP_GEOLOCATION=false

# Test IP addresses for different scenarios
TEST_IP_LOCAL=127.0.0.1
TEST_IP_PRIVATE=192.168.1.100
TEST_IP_PUBLIC_US=8.8.8.8
TEST_IP_PUBLIC_CN=223.5.5.5
TEST_IP_PUBLIC_RU=77.88.8.8
TEST_IP_PUBLIC_UK=81.2.69.142

# Test User Agents
TEST_UA_CHROME="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
TEST_UA_FIREFOX="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/121.0"
TEST_UA_SAFARI="Mozilla/5.0 (Macintosh; Intel Mac OS X 14_1) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.1 Safari/605.1.15"
TEST_UA_BOT_GOOGLE="Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"
TEST_UA_BOT_BING="Mozilla/5.0 (compatible; bingbot/2.0; +http://www.bing.com/bingbot.htm)"
TEST_UA_OLD_IE="Mozilla/5.0 (compatible; MSIE 6.0; Windows NT 5.1)"

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=/tmp/firewall_test.log

# Performance Testing
PERF_TEST_ITERATIONS=1000
PERF_TEST_CONCURRENT_REQUESTS=10