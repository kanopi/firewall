/*
 * Deprecated since 2.38.0, and removed in 3.0: use `firewall check` (#289).
 *
 * Runs exactly what `firewall check` runs, with the same arguments, output and
 * exit codes, so a deploy hook or a cron entry calling this keeps working.
 * The notice goes to a terminal only: cron mails whatever a job writes, and a
 * line on every run would be a daily email nobody asked for.
 */

if (stream_isatty(STDERR)) {
    fwrite(STDERR, "firewall-check is deprecated and will be removed in 3.0. Use `firewall check` instead.\n");
}

require __DIR__ . '/commands/check.php';
